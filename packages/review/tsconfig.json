{
  // Eigene Typprüfung wie bei der Website: dieses Paket trägt JSX, das unter der
  // Root-Konfiguration (`moduleResolution: NodeNext`, kein `jsx`) nicht auflösbar wäre. Deshalb
  // steht `packages/review` im Root-`exclude` und wird über
  // `pnpm --filter @einsatzzeichen/review typecheck` in CI geprüft.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@einsatzzeichen/schema": ["../schema/src/index.ts"],
      "@einsatzzeichen/core": ["../core/src/index.ts"],
      "@einsatzzeichen/catalog": ["../catalog/src/index.ts"],
      "@einsatzzeichen/catalog/src/*": ["../catalog/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}

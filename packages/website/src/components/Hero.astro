---
/**
 * Override von Starlights `Hero` (Spec §5.6).
 *
 * Zwei Unterschiede zur Vorlage. Erstens: das Bild ist kein Bild, sondern ein echtes Zeichen aus
 * dem Katalog — zur Buildzeit mit `renderSvg()` aus der Zeichnung des Snapshots erzeugt und inline
 * ausgegeben. Es gibt auf dieser Website keine Stock-Illustration, und der Snapshot ist die
 * einzige Datenquelle. Zweitens: jede Handlungsaufforderung trägt eine zweite Zeile
 * (`attrs['data-note']`), weil die Startseite zwei verschiedene Leserinnen bedient und beide ohne
 * Scrollen erkennen sollen, welcher Weg ihrer ist.
 *
 * Struktur und IDs folgen weiter Starlights Vertrag: die `<h1>` behält `id="_top"` (Sprungziel des
 * Skiplinks) und `data-page-title` (die Kopfzeile liest den Titel daraus).
 */
import { renderSvg } from '@einsatzzeichen/core';
import { loadSnapshot } from '../lib/snapshot';
import StatusPair from './StatusPair.astro';

/** Sprungziel des Skiplinks; entspricht `PAGE_TITLE_ID` in `@astrojs/starlight`. */
const PAGE_TITLE_ID = '_top';

/** Das Zeichen der Startseite: E.1.1, Bergungsgruppe — Anhang E.1 der Baseline. */
const HERO_SYMBOL_ID = 'recipe.E.1.1';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

const snapshot = loadSnapshot();
const symbol = snapshot.symbols.find((entry) => entry.id === HERO_SYMBOL_ID);
if (symbol === undefined) {
  // Kein stiller Rückfall auf ein beliebiges Zeichen (Spec §7): wenn das Zeichen der Startseite
  // aus dem Katalog verschwindet, soll der Build es sagen.
  throw new Error(
    `Das Zeichen der Startseite (${HERO_SYMBOL_ID}) steht nicht im Katalog-Snapshot. ` +
      'Snapshot neu erzeugen: pnpm --filter @einsatzzeichen/website generate',
  );
}

const svg = renderSvg(symbol.drawing, { idPrefix: 'ez-hero' });
const sourceLabel =
  symbol.source.page === undefined
    ? symbol.chapter
    : `${symbol.chapter}, S. ${symbol.source.page}`;
---

<div class="ez-hero">
  <div class="ez-hero__copy">
    <span class="ez-eyebrow">Taktische Zeichen im Bevölkerungsschutz</span>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {tagline && <p class="ez-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="ez-hero__actions">
          {actions.map((action) => (
            <a class="ez-action" href={action.link}>
              <strong>{action.text}</strong>
              {action.attrs?.['data-note'] !== undefined && (
                <span>{String(action.attrs['data-note'])}</span>
              )}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <figure class="ez-hero__plate">
    <div class="ez-canvas ez-canvas--light" set:html={svg} />
    <figcaption class="ez-hero__caption">
      <span class="ez-id">{symbol.id} · {symbol.title}</span>
      <span>{sourceLabel} · {symbol.source.citation}</span>
      <StatusPair technical={symbol.review.technical} domain={symbol.review.domain} compact />
    </figcaption>
  </figure>
</div>

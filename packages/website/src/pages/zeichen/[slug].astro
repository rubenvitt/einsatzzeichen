  <dl class="ez-head">
    <dt>Kennung</dt>
    <dd><code class="ez-id ez-head__copy">{symbol.id}</code></dd>

    <dt>Quelle</dt>
    <dd>
      {sourceLabel} · {symbol.source.citation} ·{' '}
      <a href="/docs/grundlage/#woher-die-zeichen-stammen">alle Quellen mit Prüfstand</a>

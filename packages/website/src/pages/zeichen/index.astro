---
/**
 * Übersicht aller Symbolseiten, gruppiert nach Kapitel und Anhang (Spec §4, §5.5).
 *
 * Jede Kachel trägt dieselben drei Angaben wie die Kopfzeile der Einzelseite: das Zeichen, seinen
 * Titel und die zwei Statusmarken in kompakter Form. Die Marken stehen hier bewusst mit auf der
 * Kachel und nicht erst auf der Detailseite — wer eine Liste überfliegt, soll den Prüfstand jedes
 * Zeichens sehen, ohne ihn einzeln aufrufen zu müssen.
 *
 * Die Miniaturen entstehen zur Buildzeit mit `renderSvg()` im Referenzprofil und stehen inline im
 * HTML — bewusst ohne Titel und Beschreibung: die Kachelfläche trägt `aria-hidden`, der Titel steht
 * sichtbar direkt darunter, und Pagefind indexiert SVG-Inhalt nicht. 256 `<title>`/`<desc>`, die
 * niemand liest und keine Vorlesehilfe erreicht, wären nur Gewicht. Ohne sie vergibt `renderSvg()`
 * auch keine IDs mehr (`core/src/render/svg.ts`), deshalb braucht hier kein Zeichen ein eigenes
 * `idPrefix`.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { renderSvg } from '@einsatzzeichen/core';
import StatusPair from '../../components/StatusPair.astro';
import { formatReviewDate } from '../../components/StatusPair.tsx';
import { reviewSummary } from '../../lib/review-summary';
import { loadSnapshot, type SymbolSummary } from '../../lib/snapshot';

const THUMBNAIL_SIZE = 64;

const snapshot = loadSnapshot();

interface ChapterGroup {
  chapter: string;
  slug: string;
  symbols: SymbolSummary[];
}

/** `Anhang E.1` → `anhang-e-1`; Sprungziel für das Inhaltsverzeichnis und für Verweise von außen. */
function anchor(chapter: string): string {
  return chapter
    .toLowerCase()
    .replaceAll('ä', 'ae')
    .replaceAll('ö', 'oe')
    .replaceAll('ü', 'ue')
    .replaceAll('ß', 'ss')
    .replaceAll(/[^a-z0-9]+/g, '-')
    .replaceAll(/^-|-$/g, '');
}

/** Kapitel vor Anhang — das ist die Reihenfolge des Aufbaus: erst die Grundzeichen, dann die Anhänge. */
function rank(chapter: string): number {
  return chapter.startsWith('Kapitel') ? 0 : 1;
}

const collator = new Intl.Collator('de', { numeric: true });
const buckets = new Map<string, SymbolSummary[]>();
for (const symbol of snapshot.symbols) {
  const bucket = buckets.get(symbol.chapter);
  if (bucket === undefined) buckets.set(symbol.chapter, [symbol]);
  else bucket.push(symbol);
}

const groups: ChapterGroup[] = [...buckets.entries()]
  .map(([chapter, symbols]) => ({
    chapter,
    slug: anchor(chapter),
    symbols: [...symbols].sort((left, right) => collator.compare(left.id, right.id)),
  }))
  .sort(
    (left, right) =>
      rank(left.chapter) - rank(right.chapter) || collator.compare(left.chapter, right.chapter),
  );

// Gemessen an `dist/zeichen/index.html` (LFH-510), damit die nächste Person nicht neu messen muss.
// Ausgangslage: 853.303 B roh / 60.636 B gzip, davon 423.128 B in 768 eigenen SVG — 256 Miniaturen
// (296.228 B, alle verschieden, kein Dedup möglich) und 512 Statusmarken (126.900 B). Drei Wege:
//   - Miniaturen ohne Titel/Beschreibung: −75.266 B roh, −9.213 B gzip (−15,2 %). Kostet nichts
//     außer dem nativen Tooltip, der denselben Titel zeigt, der sichtbar darunter steht. Umgesetzt.
//   - Statusmarken als `<symbol>` + `<use>` (nur drei verschiedene Formen): −70.630 B roh, aber nur
//     −1.309 B gzip (−2,2 %) — gzip teilt sich das Wörterbuch über die Wiederholungen ohnehin.
//     Der Preis wäre eine Sprite-Umschaltung am geteilten `StatusPair`, die ohne Sprite auf der
//     Seite stumm unsichtbare Marken erzeugt. Nicht umgesetzt: 1,3 KB sind das nicht wert.
//   - Miniaturen als `<img src="/zeichen/<slug>.svg" loading="lazy">`: im Dokument −24.718 B gzip,
//     die 256 Endpunktdateien wiegen einzeln gzippt aber 136.616 B. Wer die Seite durchblättert —
//     ihr einziger Zweck — überträgt damit 172.534 statt 60.636 B, das 2,8-fache. Nicht umgesetzt.
const thumbnails = new Map(
  snapshot.symbols.map((symbol) => [
    symbol.slug,
    renderSvg(
      { ...symbol.drawing, title: undefined, description: undefined },
      { size: THUMBNAIL_SIZE },
    ),
  ]),
);

const headings = groups.map((group) => ({ depth: 2, slug: group.slug, text: group.chapter }));

// Gezählt statt behauptet: der Satz unten wählt sich aus dem Stand, damit er nicht an dem Tag
// falsch wird, an dem sich der Stand ändert (`review-summary.ts`).
const domain = reviewSummary(snapshot.symbols).domain;
// Titel statt Kennung: `bbk-babz-2025` sagt einer Leserin nichts, die Quelle führt ihren Namen mit.
const baselineTitle =
  snapshot.sources.find((source) => source.id === snapshot.baseline)?.title ?? snapshot.baseline;
const domainSentence =
  domain.approved === 0
    ? `Fachlich geprüft ist davon bisher keines.`
    : domain.approved === domain.total
      ? `Fachlich geprüft sind inzwischen alle ${domain.total}.`
      : `Fachlich geprüft sind ${domain.approved} von ${domain.total}.`;

const frontmatter = {
  title: 'Zeichen',
  description:
    `Alle ${snapshot.symbols.length} Zeichen des Katalogs, nach Kapitel und Anhang geordnet: ` +
    'Zeichnung, Titel und der Prüfstand technisch/fachlich je Zeichen.',
};
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
  <p>
    Alle <strong>{snapshot.symbols.length} Zeichen</strong> des Katalogs, geordnet nach Kapitel und
    Anhang der Vorlage — Stand {formatReviewDate(snapshot.generatedAt.slice(0, 10))}. Die Vorlage
    dazu ist {baselineTitle}. {domainSentence} Wer wann geprüft hat, sagt
    die rechte Marke an jeder Kachel für jedes Zeichen einzeln — verlass dich auf sie und nicht auf
    den Gesamtstand. Ein Klick führt zum Zeichen — ansehen, als SVG oder PNG herunterladen, auf der
    Karte zeigen oder im Baukasten abwandeln.
  </p>

  {
    groups.map((group) => (
      <>
        <h2 id={group.slug}>
          {group.chapter}
          <span class="ez-chapter__count">{group.symbols.length}</span>
        </h2>
        <ul class="ez-grid ez-grid--4">
          {group.symbols.map((symbol) => (
            <li>
              <a class="ez-card ez-symbolcard" href={`/zeichen/${symbol.slug}/`}>
                <span class="ez-canvas ez-canvas--light ez-symbolcard__canvas" aria-hidden="true">
                  <Fragment set:html={thumbnails.get(symbol.slug)} />
                </span>
                <span class="ez-card__title">{symbol.title}</span>
                <code class="ez-id">{symbol.id}</code>
                <StatusPair
                  technical={symbol.review.technical}
                  domain={symbol.review.domain}
                  compact
                />
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</StarlightPage>

<style>
  .ez-chapter__count {
    margin-inline-start: var(--ez-space-3);
    font-family: var(--ez-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }

  /* Die Miniatur sitzt auf weißem Untergrund, weil die Referenzpalette darauf gerechnet ist. */
  .ez-symbolcard__canvas {
    min-height: 5.5rem;
  }

  .ez-symbolcard .ez-card__title {
    font-size: var(--sl-text-base);
  }
</style>

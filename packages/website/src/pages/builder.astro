---
/**
 * Der Baukasten als eigenständige Seite (Route `/builder/`, Spec §5.4) — außerhalb von
 * Starlight, mit `wide`, weil das Werkzeug die Breite braucht: links das Formular, rechts die
 * klebende Vorschau. Der lange Doku-Text der früheren `builder.mdx` ist bewusst weg; was davon
 * Entwicklerinnen betrifft, steht in der Anleitung „Ein Zeichen selbst zusammensetzen“. Über dem
 * Werkzeug bleibt ein Satz und der Weg dorthin — mehr Einleitung stünde zwischen der Leserin und
 * dem Zeichen (ESZ-150).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Builder from '../components/islands/Builder.tsx';
---

<BaseLayout
  title="Baukasten – Einsatzzeichen"
  description="Ein taktisches Zeichen beschreiben und sofort sehen: angeboten wird nur, was passt, und was nicht ins Bild kommt, steht mit Grund daneben."
  active="builder"
  wide
>
  <div class="ez-shell">
    <header class="ez-builder-head">
      <span class="ez-eyebrow">Werkzeug</span>
      <h1>Baukasten</h1>
      <p>
        Ein Zeichen beschreiben, vom Katalogzeichen aus oder von Grund auf, und sofort sehen,
        was entsteht. <a href="/docs/anleitungen/eigenes-zeichen/">Anleitung</a>
      </p>
    </header>
    <Builder client:load />
  </div>
</BaseLayout>

<style>
  .ez-builder-head {
    padding-block-start: var(--ez-space-8);
    max-width: 62ch;
  }

  .ez-builder-head h1 {
    margin: 0 0 var(--ez-space-3);
    font-size: clamp(var(--sl-text-3xl), calc(1rem + 2.4vw), var(--sl-text-4xl));
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .ez-builder-head p {
    margin: 0;
    font-size: var(--sl-text-base);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
</style>

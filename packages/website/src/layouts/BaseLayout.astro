---
/**
 * Gemeinsames Gerüst der eigenständigen Seiten (Landingpage, Baukasten) — außerhalb von
 * Starlight, aber mit denselben Gestaltungstoken: `theme.css` wird hier genauso eingebunden wie
 * dort, und der Farbmodus liest denselben `localStorage`-Schlüssel (`starlight-theme`), damit
 * eine Leserin, die in der Dokumentation auf Hell stellt, auf der Landingpage nicht im
 * Dunkelmodus landet.
 *
 * Der Kopf ist bewusst schmal: Wortmarke plus die drei Wege, die es auf dieser Website gibt.
 * Der Fuß trägt den KI-Hinweis aus Spec §3 — er gilt für jede Seite, also auch für diese beiden.
 */
import '../styles/theme.css';

interface Props {
  title: string;
  description: string;
  /** Hebt den aktuellen Weg in der Kopfzeile hervor. */
  active?: 'builder' | 'zeichen' | 'docs';
  /** Volle Breite für Werkstattseiten wie den Baukasten; sonst gedeckelt wie Fließtext. */
  wide?: boolean;
}

const { title, description, active, wide = false } = Astro.props;

const NAV = [
  { id: 'builder', label: 'Baukasten', href: '/builder/' },
  { id: 'zeichen', label: 'Zeichen', href: '/zeichen/' },
  { id: 'docs', label: 'Dokumentation', href: '/docs/' },
] as const;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      /*
       * Farbmodus vor dem ersten Rendern setzen, sonst blitzt der Dunkelmodus auf. Gelesen wird
       * Starlights Schlüssel; `auto` und ein fehlender Wert folgen der Systemeinstellung.
       */
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class:list={['ez-page', { 'ez-page--wide': wide }]}>
    <a class="ez-skip" href="#ez-main">Zum Inhalt springen</a>
    <header class="ez-site-header">
      <div class="ez-shell ez-site-header__inner">
        <a class="ez-wordmark" href="/">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="ez-wordmark__glyph">
            <rect x="1.5" y="3.5" width="13" height="9" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>
          <span>Einsatzzeichen</span>
        </a>
        <nav aria-label="Hauptnavigation" class="ez-site-nav">
          {
            NAV.map((entry) => (
              <a
                href={entry.href}
                aria-current={active === entry.id ? 'page' : undefined}
                class:list={['ez-site-nav__link', { 'ez-site-nav__link--active': active === entry.id }]}
              >
                {entry.label}
              </a>
            ))
          }
          <button type="button" class="ez-theme-toggle" data-ez-theme-toggle aria-label="Farbmodus wechseln">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
              <path d="M8 2 A6 6 0 0 1 8 14 Z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="ez-main" class="ez-site-main">
      <slot />
    </main>

    <footer class="ez-site-footer">
      <div class="ez-shell">
        <nav aria-label="Seitenfuß" class="ez-site-footer__nav">
          <a href="/builder/">Baukasten</a>
          <a href="/zeichen/">Alle Zeichen</a>
          <a href="/docs/">Dokumentation</a>
          <a href="/docs/grundlage/">Grundlage &amp; Quellen</a>
          <a href="/docs/coverage/">Stand der Prüfung</a>
        </nav>
        <p class="ez-ai-note">
          Texte und Code dieser Website sind mit KI-Unterstützung entstanden und werden von
          Menschen geprüft; der fachliche Reviewstatus steht an jedem Zeichen.
        </p>
      </div>
    </footer>

    <script is:inline>
      // Der Umschalter schreibt Starlights Schlüssel, damit die Dokumentation die Wahl übernimmt.
      document.querySelector('[data-ez-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });
    </script>

    <style>
      body.ez-page {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--sl-color-black);
        color: var(--sl-color-white);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          Arial,
          sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .ez-shell {
        width: min(100% - 2 * var(--ez-space-4), 72rem);
        margin-inline: auto;
      }

      body.ez-page--wide .ez-shell {
        width: min(100% - 2 * var(--ez-space-4), 88rem);
      }

      .ez-skip {
        position: absolute;
        inset-inline-start: var(--ez-space-4);
        inset-block-start: var(--ez-space-2);
        z-index: 10;
        padding: var(--ez-space-2) var(--ez-space-3);
        background: var(--ez-surface);
        border: 1px solid var(--ez-line);
        border-radius: var(--ez-radius);
        color: var(--sl-color-white);
        transform: translateY(-200%);
      }

      .ez-skip:focus-visible {
        transform: none;
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
      }

      .ez-site-header {
        border-block-end: 1px solid var(--sl-color-hairline-light, var(--ez-line));
        background: var(--sl-color-black);
        position: sticky;
        inset-block-start: 0;
        z-index: 5;
      }

      .ez-site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ez-space-4);
        padding-block: var(--ez-space-3);
      }

      .ez-wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        font-family: var(--ez-font-mono);
        font-size: var(--sl-text-sm);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--sl-color-white);
        white-space: nowrap;
      }

      .ez-wordmark__glyph {
        color: var(--sl-color-accent);
      }

      .ez-site-nav {
        display: flex;
        align-items: center;
        gap: var(--ez-space-4);
        flex-wrap: wrap;
      }

      .ez-site-nav__link {
        font-size: var(--sl-text-sm);
        text-decoration: none;
        color: var(--sl-color-gray-2);
        padding-block: 0.2em;
        border-block-end: 2px solid transparent;
      }

      .ez-site-nav__link:hover,
      .ez-site-nav__link:focus-visible {
        color: var(--sl-color-white);
      }

      .ez-site-nav__link--active {
        color: var(--sl-color-white);
        border-block-end-color: var(--sl-color-accent);
      }

      .ez-theme-toggle {
        display: inline-flex;
        align-items: center;
        padding: 0.4em;
        border: 1px solid var(--ez-line);
        border-radius: var(--ez-radius);
        background: transparent;
        color: var(--sl-color-gray-2);
        cursor: pointer;
      }

      .ez-theme-toggle:hover,
      .ez-theme-toggle:focus-visible {
        border-color: var(--sl-color-accent);
        color: var(--sl-color-white);
      }

      .ez-site-main {
        flex: 1;
      }

      .ez-site-footer {
        border-block-start: 1px solid var(--sl-color-hairline-light, var(--ez-line));
        padding-block: var(--ez-space-8);
        margin-block-start: var(--ez-space-12);
      }

      .ez-site-footer__nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ez-space-3) var(--ez-space-6);
        font-size: var(--sl-text-sm);
      }

      .ez-site-footer__nav a {
        color: var(--sl-color-gray-2);
        text-decoration: none;
      }

      .ez-site-footer__nav a:hover,
      .ez-site-footer__nav a:focus-visible {
        color: var(--sl-color-white);
        text-decoration: underline;
      }

      .ez-ai-note {
        margin-block: var(--ez-space-4) 0;
        font-size: var(--sl-text-2xs);
        line-height: 1.5;
        color: var(--sl-color-gray-3);
        text-wrap: pretty;
        max-width: 60ch;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
      }
    </style>
  </body>
</html>

{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@einsatzzeichen/schema": ["../schema/src/index.ts"],
      "@einsatzzeichen/core": ["../core/src/index.ts"],
      "@einsatzzeichen/core/exact": ["../core/src/exact.ts"],
      "@einsatzzeichen/core/sketch": ["../core/src/sketch/index.ts"],
      "@einsatzzeichen/core/blocks": ["../core/src/blocks/index.ts"],
      "@einsatzzeichen/core/gates": ["../core/src/gates.ts"],
      "@einsatzzeichen/conformance": ["../conformance/src/index.ts"],
      "@einsatzzeichen/react": ["../react/src/index.ts"],
      "@einsatzzeichen/web-component": ["../web-component/src/index.ts"],
      "@einsatzzeichen/maplibre": ["../maplibre/src/index.ts"],
      "@einsatzzeichen/qgis": ["../qgis/src/index.ts"]
    }
  }
}

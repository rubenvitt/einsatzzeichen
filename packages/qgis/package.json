{
  "name": "@einsatzzeichen/qgis",
  "version": "1.1.0",
  "type": "module",
  "description": "QGIS-Symbolbibliothek-Export für Einsatzzeichen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenvitt/einsatzzeichen.git",
    "directory": "packages/qgis"
  },
  "homepage": "https://github.com/rubenvitt/einsatzzeichen",
  "keywords": [
    "taktische-zeichen",
    "gefahrenabwehr",
    "bos",
    "einsatzzeichen",
    "qgis"
  ],
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@einsatzzeichen/core": "workspace:*",
    "@einsatzzeichen/schema": "workspace:*"
  }
}

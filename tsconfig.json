{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@einsatzzeichen/schema": ["./packages/schema/src/index.ts"],
      "@einsatzzeichen/core": ["./packages/core/src/index.ts"],
      "@einsatzzeichen/core/exact": ["./packages/core/src/exact.ts"],
      "@einsatzzeichen/core/sketch": ["./packages/core/src/sketch/index.ts"],
      "@einsatzzeichen/core/blocks": ["./packages/core/src/blocks/index.ts"],
      "@einsatzzeichen/core/gates": ["./packages/core/src/gates.ts"],
      "@einsatzzeichen/conformance": ["./packages/conformance/src/index.ts"],
      "@einsatzzeichen/react": ["./packages/react/src/index.ts"],
      "@einsatzzeichen/web-component": ["./packages/web-component/src/index.ts"],
      "@einsatzzeichen/maplibre": ["./packages/maplibre/src/index.ts"],
      "@einsatzzeichen/qgis": ["./packages/qgis/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "vitest.config.ts"],
  // Die Website bringt eigene Typprüfung mit (`astro check`): `astro:content` und die
  // Starlight-Quellen sind unter `moduleResolution: NodeNext` nicht auflösbar. Das
  // Fachreview-Werkzeug trägt JSX und wird aus demselben Grund eigenständig geprüft
  // (`pnpm --filter @einsatzzeichen/review typecheck`, in CI).
  "exclude": ["packages/website", "packages/review"]
}

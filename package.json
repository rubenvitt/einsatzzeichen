{
  "name": "einsatzzeichen",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Semantisches Symbolsystem für taktische Zeichen der Gefahrenabwehr",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.packages.json && node scripts/release/copy-conformance-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx packages/cli/src/index.ts",
    "review": "pnpm --filter @einsatzzeichen/review dev"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "semantic-release-claude-changelog": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}
